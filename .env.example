# J.A.R.V.I.S. configuration
# Copy this file to .env and fill only what you want to use.
# Never commit real API keys.

# AI brain: one agent, two interchangeable providers
JARVIS_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
JARVIS_AI_TIMEOUT=120

# Optional Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Voice input: stays local
JARVIS_WAKE_WORDS=jarvis,viernes
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# Text-to-speech
# ElevenLabs is the main voice; pyttsx3 is the local fallback.
JARVIS_TTS=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=W5JElH3dK1UYYAiHH7uh
ELEVENLABS_MODEL=eleven_multilingual_v2
# pcm_22050 works directly with sounddevice without requiring 44.1 kHz PCM.
ELEVENLABS_OUTPUT_FORMAT=pcm_22050
LOCAL_VOICE_RATE=175
LOCAL_VOICE_VOLUME=1.0
