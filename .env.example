# J.A.R.V.I.S. configuration
# Copia este archivo a .env y completa solo lo que vayas a usar.
# Nunca publiques claves reales.

# Cerebro: un solo agente. Gemini es principal; Ollama es respaldo/local.
JARVIS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
JARVIS_AI_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m
JARVIS_MAX_HISTORY_MESSAGES=12

# Computer Use / visión
JARVIS_COMPUTER_MAX_STEPS=10
JARVIS_SCREEN_CAPTURE=explicit_only
JARVIS_REQUIRE_CONFIRMATION=true

# Voz
JARVIS_WAKE_WORDS=jarvis,viernes
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# TTS local por defecto. ElevenLabs es opcional.
JARVIS_TTS=local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_22050
LOCAL_VOICE_RATE=175
LOCAL_VOICE_VOLUME=1.0
