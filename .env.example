# J.A.R.V.I.S. configuration
# Copy this file to .env and fill only what you want to use.
# Never commit your real API keys.

# Local AI (default)
JARVIS_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional Claude API. Never commit your real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Voice input
JARVIS_WAKE_WORDS=jarvis,viernes
WHISPER_MODEL=base

# Text-to-speech
# elevenlabs = natural cloud voice; local = pyttsx3 fallback only
JARVIS_TTS=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_44100
