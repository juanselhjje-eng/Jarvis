# J.A.R.V.I.S. configuration
# Copy this file to .env and fill only what you want to use.

# Local AI (default)
JARVIS_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional Claude API. Never commit your real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Voice
JARVIS_WAKE_WORDS=jarvis,viernes
WHISPER_MODEL=base
