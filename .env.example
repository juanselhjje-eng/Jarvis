# J.A.R.V.I.S. configuration
# Copy this file to .env and fill only what you want to use.
# Never commit real API keys.

# AI brain: one agent, two interchangeable providers.
# Gemini is the primary cloud brain; Ollama is the local fallback.
JARVIS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
JARVIS_AI_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m
JARVIS_MAX_HISTORY_MESSAGES=12

# Voice input: stays local
JARVIS_WAKE_WORDS=jarvis,viernes
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# Text-to-speech
# ElevenLabs is optional; pyttsx3 remains the local fallback.
JARVIS_TTS=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=W5JElH3dK1UYYAiHH7uh
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_22050
LOCAL_VOICE_RATE=175
LOCAL_VOICE_VOLUME=1.0
